
# Oracle Database 19c
# Source Database: ORCL
# Target Instance: TEST6
# Initial PFILE for RMAN Restore

*.audit_file_dest='/u01/app/oracle/admin/test6/adump'
*.audit_trail='db'
*.compatible='19.0.0'
*.control_files='/u01/app/oracle/oradata/TEST6/control01.ctl','/u01/app/oracle/fast_recovery_area/TEST6/control02.ctl'
*.db_block_size=8192
*.db_domain='localdomain'
*.db_name='ORCL'
*.db_unique_name='TEST6'
*.db_recovery_file_dest='/u01/app/oracle/fast_recovery_area/TEST6'
*.db_recovery_file_dest_size=8256m
*.diagnostic_dest='/u01/app/oracle'
*.dispatchers='(PROTOCOL=TCP) (SERVICE=TEST6XDB)'
*.memory_target=1451m
*.nls_language='AMERICAN'
*.nls_territory='AMERICA'
*.open_cursors=300
*.processes=300
*.remote_login_passwordfile='EXCLUSIVE'
*.undo_tablespace='UNDOTBS1'
